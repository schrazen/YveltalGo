{
  "name": "yveltalgo-control-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "npm run build && npm run desktop:app",
    "electron:attach": "electron electron/main.mjs",
    "electron:attach:backend": "cross-env ELECTRON_MANAGE_BACKEND=1 electron electron/main.mjs",
    "electron:attach:backend:app": "cross-env ELECTRON_MANAGE_BACKEND=1 ELECTRON_UI_URL=http://127.0.0.1:8787 electron electron/main.mjs",
    "desktop:app": "npm run build && npm run electron:attach:backend:app",
    "desktop:dev": "concurrently -k -n VITE,ELECTRON \"vite --host 127.0.0.1 --port 5173 --strictPort\" \"wait-on http://127.0.0.1:5173 && npm run electron:attach:backend\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "wait-on": "^8.0.3",
    "vite": "^5.4.10"
  }
}